# 虚拟环境
venv/

# Python 缓存
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# 本地数据库和日志
chroma_db/
# 打开失败时自动隔离的旧向量库（见 README「常见问题」）
chroma_db.broken_*/
logs/
*.log
# 本地账号库，含密码哈希，只在本机使用
data/app.db
data/app.db-journal
data/app.db-wal
data/app.db-shm
# 历史遗留：旧版本的知识库导入去重记录，新版本已改为存入向量库元数据
/md5.txt

# 本地密钥配置；.env.example 只能包含变量名和占位符
.env
.env.*
!.env.example
.streamlit/secrets.toml
# config/ 当前只有模型名称、服务地址、路径等非敏感配置，需要提交

# IDE 文件
.idea/
.vscode/

# 系统文件
.DS_Store
Thumbs.db
